{
  "name": "bilibili",
  "author": "monkeyWie",
  "title": "哔哩哔哩",
  "description": "哔哩哔哩视频下载扩展，支持分P、已购课堂及会员购课程和音视频合并",
  "icon": "icon.png",
  "version": "2.2.2",
  "homepage": "https://github.com/monkeyWie/gopeed-extension-bilibili",
  "repository": {
    "url": "https://github.com/monkeyWie/gopeed-extension-bilibili"
  },
  "scripts": [
    {
      "event": "onResolve",
      "match": {
        "urls": [
          "*://*.bilibili.com/video/*",
          "*://b23.tv/*",
          "https://www.bilibili.com/cheese/play/*",
          "https://bilibili.com/cheese/play/*",
          "https://mall.bilibili.com/lesson/play*"
        ]
      },
      "entry": "dist/index.js"
    },
    {
      "event": "onStart",
      "match": {
        "labels": ["monkeyWie@bilibili"]
      },
      "entry": "dist/index.js"
    },
    {
      "event": "onError",
      "match": {
        "labels": ["monkeyWie@bilibili"]
      },
      "entry": "dist/index.js"
    }
  ],
  "settings": [
    {
      "name": "quality",
      "title": "画质",
      "type": "number",
      "value": 80,
      "options": [
        {
          "label": "8K 超高清",
          "value": 127
        },
        {
          "label": "超清 4K",
          "value": 120
        },
        {
          "label": "高帧率 1080P60",
          "value": 116
        },
        {
          "label": "高码率 1080P+",
          "value": 112
        },
        {
          "label": "高清 1080P",
          "value": 80
        },
        {
          "label": "高帧率 720P60",
          "value": 74
        },
        {
          "label": "高清 720P",
          "value": 64
        },
        {
          "label": "清晰 480P",
          "value": 32
        },
        {
          "label": "流畅 360P",
          "value": 16
        }
      ]
    },
    {
      "name": "qualityFallback",
      "title": "画质备选",
      "description": "没有匹配到指定画质时生效",
      "type": "string",
      "value": "best",
      "options": [
        {
          "label": "最高画质",
          "value": "best"
        },
        {
          "label": "最低画质",
          "value": "lowest"
        }
      ]
    },
    {
      "name": "hdr",
      "title": "开启 HDR",
      "type": "boolean",
      "value": false
    },
    {
      "name": "dbs",
      "title": "开启杜比视界",
      "type": "boolean",
      "value": false
    },
    {
      "name": "cookie",
      "title": "网站 Cookie",
      "description": "Cookie 可以通过浏览器开发者工具获取",
      "type": "string"
    },
    {
      "name": "mallCookie",
      "title": "会员购 Cookie（可选）",
      "description": "会员购登录失败时，填写在 mall.bilibili.com 课程页面获取的完整请求 Cookie。留空使用网站 Cookie。",
      "type": "string",
      "value": ""
    }
  ]
}
